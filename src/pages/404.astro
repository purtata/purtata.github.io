---
// GitHub Pages shows dist/404.html for every address that doesn't exist.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Page not found · Krzysztof Piotrowski">
  <meta slot="head" name="robots" content="noindex">
  <header class="hero">
    <h1>Page not found</h1>
    <p class="meta">This address doesn't exist (any more).</p>
    <p class="actions"><a class="btn primary" href="/">Go to the CV</a></p>
  </header>
  <main></main>
</BaseLayout>
